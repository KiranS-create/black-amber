# ==============================================================================
# AegisTrace Workstation — Environment Configuration
# ==============================================================================

# Server Network Configuration
SIH_HOST=0.0.0.0
SIH_PORT=8000
SIH_DATA_DIR=data

# Base URLs (Optional: customize for public proxy or CDN deployment)
PUBLIC_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

# CORS Allowed Origins (Comma-separated list or *)
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# Demonstration & Evaluation Settings
# IMPORTANT: In production deployments, keep DEMO_AUTH_ENABLED=false.
# When DEMO_AUTH_ENABLED=true:
#  - admin/admin credentials are valid for SIH judge evaluation
#  - All actions are isolated in the 'demo_tenant' workspace
#  - An unambiguous [DEMO DATA] badge is shown in the UI
# ------------------------------------------------------------------------------
DEMO_AUTH_ENABLED=false
DEMO_USERNAME=admin
DEMO_PASSWORD=admin
DEMO_TENANT_ID=demo_tenant

# Rate Limiting Parameters (Requests per minute for unauthenticated auth endpoints)
AUTH_RATE_LIMIT_MAX_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
